<Page x:Class="Sinuyshina41_3.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Sinuyshina41_3"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Логин" Grid.Row="0" Grid.Column="0" FontSize="20" HorizontalAlignment="Center" Height="50"></TextBlock>
        <TextBox Name="LoginTB" Grid.Row="0" Grid.Column="1" Width="200" Height="50" HorizontalAlignment="Left" Margin="30,0,0,0"></TextBox>

        <TextBlock Text="Пароль" Grid.Row="1" Grid.Column="0" FontSize="20" HorizontalAlignment="Center" Height="50" VerticalAlignment="Top" ></TextBlock>
        <TextBox Name="PassTB" Grid.Row="1" Grid.Column="1" FontSize="20" HorizontalAlignment="Left" Width="200" Height="50" Margin="30,0,0,0" VerticalAlignment="Top" ></TextBox>

        <Button Name="BGuestEntry" Click="BGuestEntry_Click" Grid.Row="2" Grid.Column="0" Content="Войти как гость"></Button>
        <Button Name="LoginBtn" Click="LoginBtn_Click" Grid.Row="2" Grid.Column="1" Content="Войти" ></Button>

        <StackPanel Name="CaptchaPanel" Orientation="Horizontal" Grid.Row="1" Grid.Column="1" Visibility="Collapsed" Margin="20,10,10,10" VerticalAlignment="Bottom">
            <TextBlock Name="captchaOneWord" FontSize="22" FontWeight="Bold"></TextBlock>
            <TextBlock Name="captchaTwoWord" FontSize="22" FontWeight="Bold"></TextBlock> <!--TextDecorations="Strikethrough"-->
            <TextBlock Name="captchaThreeWord" FontSize="22" FontWeight="Bold"></TextBlock>
            <TextBlock Name="captchaFourWord" FontSize="22"  FontWeight="Bold"></TextBlock>
            <TextBox Name="TBoxCaptcha" Width="150" Height="30" FontSize="16" Margin="5" Visibility="Collapsed"></TextBox>

        </StackPanel>
        
        
    </Grid>
</Page>
