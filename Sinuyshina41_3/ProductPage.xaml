<Page x:Class="Sinuyshina41_3.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Sinuyshina41_3"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductPage" FontFamily="Comic Sans MS">

    <Grid>
        <!--<Button Content="Go" Background="#FFCC6600" Click="Button_Click"></Button>-->
        
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        
        <StackPanel Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Top" Grid.Row="0" >

            <TextBlock Text="Вы авторизированы как " FontSize="15" Name="X"></TextBlock>
            <TextBlock Name="FIOTB"  FontSize="15" ></TextBlock>


            <TextBlock Text="Роль: " FontSize="15" Name="Y"></TextBlock>
            <TextBlock Name="RoleTB" FontSize="15" ></TextBlock>
          
            
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Width="800" Height="50">
            <!--dfvgh-->

            <StackPanel Orientation="Horizontal" Width="180" VerticalAlignment="Bottom" Height="41" Margin="10,0,10,0">
                <TextBlock Name="TBCount" Text="{Binding ElementName=ProductListView, Path=Items.Count, StringFormat=Всего записей: {0}}" FontSize="15" Height="20"></TextBlock>
                <TextBlock Name="TBAllRecords" FontSize="15" Height="20"></TextBlock>
            </StackPanel>

            <StackPanel Orientation="Vertical" VerticalAlignment="Bottom" Margin="5">
                <TextBlock Text="поиск по наименованию" TextAlignment="Center" 
                           Width="180" FontSize="15" ></TextBlock>
                <TextBox Name="TBoxSearch" TextChanged="TBoxSearch_TextChanged"
                         Width="151" FontSize="15" Height="23"></TextBox>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,5,0,5" Width="230" VerticalAlignment="Bottom">
                <RadioButton Content="по возрастанию стоимости" GroupName="Sort"
                    Width="300" FontSize="15" Name="RButtonUp" Checked="RButtonUp_Checked"></RadioButton>
                <RadioButton Content="по убыванию стоимости" GroupName="Sort" 
                    Width="300" FontSize="15" Name="RButtonDown" Checked="RbuttonDown_Checked"></RadioButton>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,5,0,5" Width="165" VerticalAlignment="Bottom">
                <TextBlock Text="Фильтрация по скидке" TextAlignment="Center" 
                           Width="165" FontSize="15"></TextBlock>
                <ComboBox Name="ComboType" SelectionChanged="ComboType_SelectionChanged"
                          Width="150" FontSize="15">
                    <TextBlock>Все</TextBlock>
                    <TextBlock>от 0 до 9,99%</TextBlock>
                    <TextBlock>от 10 до 14,99%</TextBlock>
                    <TextBlock>от 15 и более</TextBlock>
                </ComboBox>
            </StackPanel>


        </StackPanel>


        <ListView Name="ProductListView" Grid.Row="2" >
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" ></ColumnDefinition>
                            <!--Width="*"-->
                            <ColumnDefinition Width="500"></ColumnDefinition>
                            <ColumnDefinition ></ColumnDefinition>
                            <!--Width="50"-->
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>
                        <Image Width="150" Height="200" Grid.Column="0" Grid.RowSpan="4" Stretch="Uniform" HorizontalAlignment="Center">
                            <Image.Source>
                                <Binding Path="PhotoPathFull">
                                    <Binding.TargetNullValue>
                                        <ImageSource>
                                            /Resources/picture.png

                                        </ImageSource>
                                    </Binding.TargetNullValue>
                                </Binding>
                            </Image.Source>
                        </Image>
                        <TextBlock Text="{Binding ProductName}" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left" FontSize="15" TextWrapping="Wrap" FontWeight="Bold"></TextBlock>
                        <TextBlock Text="{Binding ProductDescription}" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Left" FontSize="15" ></TextBlock>
                        <TextBlock Text="{Binding Manufacturer.NameManufacterer}" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Left" FontSize="15" Margin="0,15,0,0" ></TextBlock><!--jkhjkl-->
                        <TextBlock Text="{Binding ProductCost, StringFormat={}{0:0} рублей}" Grid.Column="1" Grid.Row="3" HorizontalAlignment="Left" FontSize="15" Margin="0,0,0,20"></TextBlock>
                        <TextBlock Text="{Binding ProductDiscountAmount, StringFormat={}{0:0} %}" Margin="5" Grid.Column="2" Grid.Row="2" HorizontalAlignment="Right" FontSize="30" ></TextBlock>
                        <TextBlock Text="Скидка" Margin="5" Grid.Column="2" Grid.Row="0" HorizontalAlignment="Right" FontSize="15" TextWrapping="Wrap"></TextBlock>

                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>

</Page>
